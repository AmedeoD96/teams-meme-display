# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# PlatformIO
firmware/.pio/
firmware/.vscode/

# Generated LittleFS image contents (rebuild with tools/build_memes.py)
firmware/data/memes/
firmware/data/captions/
firmware/data/manifest.json
# The re-encoded copy of assets/alert.gif; the source of it is committed, this is build output.
firmware/data/alert.gif

# Meme preview renders
preview/

# Packaged app and generated icon (rebuild: python tools/build_exe.py)
dist/
build/
assets/icon.ico

# User-supplied meme sources. Real memes are usually copyrighted, so they stay local.
# The bundled placeholders (generated by tools/make_samples.py) are the exception.
memes/*/*
!memes/*/00_sample.*.png
.tokensave/
graphify-out/
